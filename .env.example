# Copy to .env and fill in. Never commit .env.

# Nest: Google Cloud OAuth client and Device Access project ID (see README)
HEATMON_GOOGLE_CLIENT_ID=
HEATMON_GOOGLE_CLIENT_SECRET=
HEATMON_SDM_PROJECT_ID=

# Weather Underground API key (wunderground.com/member/api-keys)
HEATMON_WU_API_KEY=

# CentriConnect / MyPropane
HEATMON_CENTRICONNECT_USER_ID=
HEATMON_CENTRICONNECT_DEVICE_ID=
HEATMON_CENTRICONNECT_DEVICE_AUTH=
